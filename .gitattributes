# Line endings stay LF (shell scripts break with CRLF); binaries are never diffed.
* text=auto eol=lf
*.sh text eol=lf
scripts/* text eol=lf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.bin binary
*.onnx binary
*.ttf binary
*.otf binary
*.woff2 binary
*.pdf binary

# Generated: collapsed in pull request diffs.
docs/api/openapi.json linguist-generated=true
**/pubspec.lock linguist-generated=true
**/package-lock.json linguist-generated=true
infra/aws/.terraform.lock.hcl linguist-generated=true
