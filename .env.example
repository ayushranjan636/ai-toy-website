# ---------------------------------------------------------------
# Zivoo website — environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------

# Public site URL — used for canonical URLs, sitemap, structured data and social cards.
# Optional: the code falls back to https://www.zivootoy.in when unset.
NEXT_PUBLIC_SITE_URL=https://www.zivootoy.in

# Waitlist storage: "google-sheets" (production) or "file" (local testing only).
# If unset, the form clearly reports that sign-ups are unavailable — it never fakes success.
WAITLIST_STORE=google-sheets

# Google Sheets (server-only — never prefix these with NEXT_PUBLIC_)
# 1. Web app URL from Apps Script → Deploy → Web app (ends in /exec)
GOOGLE_SHEETS_WEBHOOK_URL=
# 2. A long random string. The same value goes in Apps Script → Project Settings
#    → Script Properties as WAITLIST_SECRET. Generate one with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOOGLE_SHEETS_SECRET=

# Optional public details. Leave blank to hide them from the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=

# Public brand profiles, comma-separated full https URLs. Feeds Organization/Brand
# `sameAs` in structured data so Google and AI assistants link them to Zivoo.
# e.g. https://www.instagram.com/zivootoy,https://www.youtube.com/@zivootoy,https://www.linkedin.com/company/cogniveda
NEXT_PUBLIC_SAME_AS=

# Search console verification tokens (optional).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
